{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "off"
    },
    "plugins": [
        "eslint",
        "import",
        "promise",
        "typescript",
        "unicorn"
    ],
    "jsPlugins": [
        {
            "name": "stylistic",
            "specifier": "/usr/src/quality-runner/node_modules/@stylistic/eslint-plugin/dist/index.js"
        },
        {
            "name": "lixpi",
            "specifier": "/usr/src/quality-runner/lixpi-oxlint-plugin.ts"
        }
    ],
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/testUtils/**/*.ts",
        "**/test/**/*.ts",
        "**/tests/**/*.ts",
        "**/__tests__/**/*.ts",
        "**/mocks/**/*.ts",
        "packages-vendor/**",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs"
    ],
    "rules": {
        "arrow-body-style": "off",
        "stylistic/semi": [
            "error",
            "never",
            {
                "beforeStatementContinuationChars": "always"
            }
        ],
        "import/consistent-type-specifier-style": [
            "error",
            "prefer-inline"
        ],
        "import/extensions": [
            "error",
            "ignorePackages",
            {
                "checkTypeImports": true,
                "ignorePackages": true,
                "pattern": {
                    "ts": "always"
                }
            }
        ],
        "import/no-commonjs": "error",
        "import/no-duplicates": [
            "error",
            {
                "preferInline": true
            }
        ],
        "no-debugger": "error",
        "lixpi/no-block-comments": "error",
        "lixpi/no-native-console-logging": "error",
        "lixpi/no-comma-separated-statements": "error",
        "lixpi/no-unused-imports": "error",
        "lixpi/prefer-attached-trailing-comma": "error",
        "lixpi/prefer-arrow-function-declaration": "error",
        "lixpi/prefer-compact-if": "error",
        "lixpi/prefer-expression-arrow-body": "error",
        "lixpi/prefer-multiline-attr-chain": "error",
        "lixpi/prefer-multiline-collection": "error",
        "lixpi/prefer-multiline-object-pattern": "error",
        "lixpi/prefer-separated-statements": "error",
        "lixpi/prefer-multiline-type-literal": "error",
        "lixpi/prefer-multiline-condition": "error",
        "lixpi/prefer-void-arrow-body": "error",
        "no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "axios",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "got",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "ky",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "needle",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "node-fetch",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "react",
                        "message": "React is prohibited in this repository. Use the repository DOM APIs."
                    },
                    {
                        "name": "react-dom",
                        "message": "React is prohibited in this repository. Use the repository DOM APIs."
                    },
                    {
                        "name": "superagent",
                        "message": "Use the native fetch API."
                    },
                    {
                        "name": "undici",
                        "message": "Use the native fetch API."
                    }
                ],
                "patterns": [
                    {
                        "group": [
                            "axios/*",
                            "got/*",
                            "ky/*",
                            "needle/*",
                            "node-fetch/*",
                            "superagent/*",
                            "undici/*"
                        ],
                        "message": "Use the native fetch API."
                    },
                    {
                        "group": [
                            "react/*",
                            "react-dom/*"
                        ],
                        "message": "React is prohibited in this repository. Use the repository DOM APIs."
                    }
                ]
            }
        ],
        "prefer-object-has-own": "error",
        "prefer-arrow-callback": "error",
        "prefer-template": "error",
        "promise/prefer-await-to-then": "error",
        "typescript/consistent-type-definitions": [
            "error",
            "type"
        ],
        "typescript/consistent-type-imports": [
            "error",
            {
                "disallowTypeAnnotations": false,
                "fixStyle": "inline-type-imports",
                "prefer": "type-imports"
            }
        ],
        "typescript/no-require-imports": "error",
        "unicorn/prefer-at": "error",
        "unicorn/prefer-modern-dom-apis": "error",
        "unicorn/prefer-module": "error",
        "unicorn/prefer-structured-clone": "error"
    },
    "overrides": [
        {
            "files": ["**/*.d.ts"],
            "rules": {
                "typescript/consistent-type-definitions": "off"
            }
        },
        {
            "files": [
                "**/import-specifier-order.ts",
                "**/lixpi-oxlint-plugin.ts",
                "**/source-extension-runner.ts",
                "**/stylelint-lixpi-plugin.ts",
                "**/stylelint-runner.ts",
                "**/stylelint.config.ts",
                "**/typescript-format-runner.ts"
            ],
            "rules": {
                "lixpi/require-ast-formatter-rules": "error"
            }
        },
        {
            "files": ["**/*.test.ts", "**/*.spec.ts", "**/testUtils/**/*.ts", "**/test/**/*.ts", "**/tests/**/*.ts", "**/__tests__/**/*.ts", "**/mocks/**/*.ts"],
            "rules": {
                "arrow-body-style": "off",
                "lixpi/no-block-comments": "off",
                "lixpi/no-comma-separated-statements": "off",
                "lixpi/no-unused-imports": "off",
                "lixpi/prefer-attached-trailing-comma": "off",
                "lixpi/prefer-arrow-function-declaration": "off",
                "lixpi/prefer-compact-if": "off",
                "lixpi/prefer-expression-arrow-body": "off",
                "lixpi/prefer-multiline-attr-chain": "off",
                "lixpi/prefer-multiline-collection": "off",
                "lixpi/prefer-multiline-object-pattern": "off",
                "lixpi/prefer-separated-statements": "off",
                "lixpi/prefer-multiline-type-literal": "off",
                "lixpi/prefer-multiline-condition": "off",
                "lixpi/prefer-void-arrow-body": "off",
                "prefer-arrow-callback": "off"
            }
        },
        {
            "files": ["services/web-ui/src/**/*.ts"],
            "excludeFiles": [
                "**/*.test.ts",
                "services/web-ui/src/components/proseMirror/plugins/testUtils/**"
            ],
            "rules": {
                "no-restricted-properties": [
                    "error",
                    {
                        "object": "document",
                        "property": "createElement",
                        "message": "Use the html tagged template from @lixpi/ui-primitives/dom."
                    },
                    {
                        "object": "document",
                        "property": "createElementNS",
                        "message": "Use D3 for SVG UI."
                    },
                    {
                        "property": "setAttribute",
                        "message": "Use the html template, dataset, ARIA reflection, or direct DOM properties."
                    }
                ]
            }
        },
        {
            "files": [
                "services/web-ui/**/*.ts",
                "services/ai-model-registry/src/client/**/*.ts",
                "packages/lixpi/**/src/frontend/**/*.ts",
                "packages/lixpi/canvas-engine/examples/**/*.ts",
                "packages/lixpi/canvas-components/examples/**/*.ts",
                "packages/lixpi/debug-tools/**/*.ts",
                "packages/lixpi/prosemirror/**/*.ts",
                "packages/lixpi/ui-kit/**/*.ts",
                "packages/lixpi/ui-primitives/**/*.ts"
            ],
            "rules": {
                "lixpi/no-native-console-logging": "off"
            }
        }
    ]
}
