{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "embeddedLanguageFormatting": "off",
    "endOfLine": "lf",
    "ignorePatterns": [
        "**/*.css",
        "**/*.scss",
        "**/node_modules/**",
        "packages-vendor/**"
    ],
    "objectWrap": "preserve",
    "printWidth": 320,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false
}
