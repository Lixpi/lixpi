        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@lixpi/auth-client": "workspace:*",
        "@lixpi/ui-kit": "workspace:*",
        "@lixpi/constants": "workspace:*",
        "@lixpi/nats-service": "workspace:*",
        "@lixpi/user-portal": "workspace:*",
        "@lixpi/web-client-service-factory": "workspace:*"
    },
    "devDependencies": {
        "@vitest/ui": "5.0.5",
        "happy-dom": "21.0.4",
        "http-server": "14.1.1",
        "sass": "1.107.0",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "packageManager": "pnpm@12.16.1"
}
