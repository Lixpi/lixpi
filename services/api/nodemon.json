{
    "watch": [
        "src",
        "packages/lixpi/*/src/**/*",
        "packages/lixpi/*/ts/**/*"
    ],
    "ext": "js,ts,json,env",
    "ignore": [
        "src/**/*.spec.ts",
        "**/node_modules/**"
    ],
    "legacyWatch": true,
    "exitcrash": true,
    "exec": "sh ./scripts/nodemon-exec.sh"
}
