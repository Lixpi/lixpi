        "@lixpi/dynamodb-service": "workspace:*",
        "@lixpi/ssm-service": "workspace:*",
        "@lixpi/sns-service": "workspace:*",
        "@lixpi/sqs-service": "workspace:*",
        "@lixpi/lambda-service": "workspace:*",
        "@lixpi/debug-tools": "workspace:*",
        "@lixpi/nats-service": "workspace:*",
        "@lixpi/nats-auth-callout-service": "workspace:*",
        "@lixpi/prosemirror": "workspace:*",
        "@lixpi/markdown-stream-parser": "latest",
        "cookie-parser": "*",
        "cors": "*",
        "chalk": "*",
        "decimal.js": "*",
