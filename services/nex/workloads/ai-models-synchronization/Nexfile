# Nexfile — ai-models-sync (native / service)
#
# Canonical declaration of the AI-models catalog sync workload. This file
# documents the contract; the actual deploy is performed by
# services/nex/entrypoint.sh, which injects the runtime `environment` from the
# container env at `nex workload start` time. That injection is required because
# the native nexlet does NOT inherit the container env — agents/native/state.go
# sets the child process env to ONLY start_request.environment (+ NEX_WORKLOAD_*
# creds). Secrets (provider API keys, AWS config) therefore cannot live in this
# committed file; the entrypoint supplies them at deploy time.
#
# No `tags:` — placement tags on a workload are AND-matched against node tags,
# so requiring a tag no node carries would fail the auction. The single Lixpi
# node bids on the untagged request.
name: ai-models-sync
description: Hourly synchronization of the AI models catalog into DynamoDB
type: native
lifecycle: service
start_request:
  # Run the TypeScript wrapper directly via Node type-stripping (as the API does).
  uri: "file:///usr/local/bin/node"
  argv:
    - "--experimental-transform-types"
    - "--disable-warning=ExperimentalWarning"
    - "/usr/src/service/workloads/ai-models-synchronization/index.ts"
  # The entrypoint injects these from container env at deploy time:
  #   ORG_NAME, STAGE, ENVIRONMENT, AWS_REGION, AWS_PROFILE, DYNAMODB_ENDPOINT,
  #   OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY,
  #   ANTHROPIC_USE_AWS_BEDROCK_INFERENCE,
  #   STABILITY_USE_AWS_BEDROCK_INFERENCE,
  #   STABLE_DIFFUSION_USE_AWS_BEDROCK_INFERENCE, HOME, PATH
  environment:
    LIXPI_SYNC_INTERVAL_MS: "3600000"
