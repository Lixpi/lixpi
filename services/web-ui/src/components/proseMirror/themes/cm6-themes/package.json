{
  "name": "cm6-themes",
  "description": "Theme packages for the CodeMirror code editor",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "clean": "rimraf ./packages/*/dist ./example/dist",
    "watch": "node scripts/watch.ts",
    "example": "rollup -c rollup.example.config.ts",
    "example:watch": "rollup -w -c rollup.example.config.ts",
    "prepare": "npm run -w '*' prepare"
  },
  "keywords": [
    "editor",
    "code",
    "codemirror"
  ],
  "author": {
    "name": "Takuya Matsuyama",
    "email": "hi+github@craftz.dog",
    "url": "https://www.craftz.dog/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftzdog/cm6-themes.git"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "1.0.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "rollup": "4.63.4",
    "rollup-plugin-dev": "2.1.0",
    "rollup-plugin-typescript2": "0.37.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "prettier": {
    "arrowParens": "avoid",
    "singleQuote": true,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "semi": false,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.4",
    "@lezer/markdown": "1.7.2",
    "codemirror": "6.0.2"
  }
}
