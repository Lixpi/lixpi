{
    "title": "Lixpi Dev Console",
    "actions": [
        {
            "id": "start",
            "label": "Start services",
            "script": "shared:start-services",
            "steps": [
                { "type": "env-file" },
                {
                    "type": "choices",
                    "message": "Which services should run?",
                    "options": [
                        {
                            "name": "rebuild",
                            "label": "Containers",
                            "choices": [
                                { "value": "false", "label": "Use existing", "hint": "Builds only what is missing" },
                                { "value": "true", "label": "Rebuild", "hint": "Rebuilds the selected images without cache" }
                            ]
                        },
                        {
                            "name": "detach",
                            "label": "Run",
                            "choices": [
                                { "value": "false", "label": "Foreground", "hint": "Keeps the console attached to the logs, Ctrl+C stops" },
                                { "value": "true", "label": "Detached", "hint": "Starts in the background and returns" }
                            ]
                        }
                    ],
                    "services": true
                }
            ]
        },
        {
            "id": "desktop-app",
            "label": "Build the macOS desktop app",
            "hint": "Lixpi.app for the chosen environment",
            "script": "local:build-desktop-app",
            "steps": [
                { "type": "env-file" },
                {
                    "type": "choices",
                    "message": "How should the app be built?",
                    "options": [
                        {
                            "name": "target",
                            "label": "Mac",
                            "choices": [
                                { "value": "aarch64-apple-darwin", "label": "Apple silicon" },
                                { "value": "x86_64-apple-darwin", "label": "Intel" }
                            ]
                        },
                        {
                            "name": "hot-reload",
                            "label": "Hot reload",
                            "choices": [
                                { "value": "true", "label": "On", "hint": "The page updates as soon as web-ui rebuilds a change" },
                                { "value": "false", "label": "Off", "hint": "For a release: the page changes only when reloaded with Cmd+R" }
                            ]
                        },
                        {
                            "name": "debug",
                            "label": "Debug mode",
                            "choices": [
                                { "value": "false", "label": "Off", "hint": "A normal build" },
                                { "value": "true", "label": "On", "hint": "Logs the page's console, errors and page loads to ~/Library/Logs/com.lixpi.desktop/diagnostics.log" }
                            ]
                        },
                        {
                            "name": "rebuild",
                            "label": "Builder",
                            "choices": [
                                { "value": "false", "label": "Use existing", "hint": "Builds the builder image only when it is missing" },
                                { "value": "true", "label": "Rebuild", "hint": "Rebuilds the builder image without cache, picking up a new macOS SDK" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "aws-login",
            "label": "Sign in to AWS SSO",
            "script": "shared:aws-sso-login",
            "steps": [{ "type": "env-file" }]
        },
        { "id": "configure", "label": "Create or edit a configuration", "script": "local:init-config", "returnToMenu": true },
        {
            "id": "infrastructure",
            "label": "Initialize infrastructure",
            "hint": "TLS certificates and DynamoDB tables",
            "script": "local:init-infrastructure",
            "steps": [
                { "type": "env-file" },
                {
                    "type": "choices",
                    "message": "The local stack serves HTTPS with certificates from its own certificate authority, kept in the caddy-certs Docker volume. Browsers accept them only if this computer trusts that authority. The desktop app trusts it on its own.",
                    "options": [
                        {
                            "name": "regenerate-certificate",
                            "label": "Regenerate certificate",
                            "reported": true,
                            "choices": [
                                { "value": "keep", "label": "Keep", "hint": "Reuses the certificate authority and certificates already in the volume" },
                                { "value": "regenerate", "label": "Regenerate", "hint": "Replaces the certificate authority, so a computer that trusts the old one needs the new one installed, and running services need a restart" }
                            ]
                        },
                        {
                            "name": "trust-certificate",
                            "label": "Install certificate",
                            "choices": [
                                { "value": "skip", "label": "Skip", "hint": "Leaves this computer's trust store unchanged. Enough for the desktop app and remote environments" },
                                { "value": "install", "label": "Install", "hint": "Adds the authority to this computer's trust store (asks for your password), so a browser opens the local web-ui, Profile, API and NATS without certificate errors" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "pulumi",
            "label": "Deploy and manage infrastructure",
            "hint": "Everything the Pulumi service offers",
            "script": "local:pulumi",
            "steps": [{ "type": "env-file" }, { "type": "service-commands" }]
        },
        {
            "id": "prune",
            "label": "Prune Docker",
            "hint": "Reclaim disk space from containers, images, volumes and build cache",
            "script": "shared:prune-docker",
            "steps": [{ "type": "docker-prune" }]
        },
        { "id": "skills", "label": "Install agent skills", "script": "shared:setup-skills" }
    ]
}
