{
    "title": "Lixpi Dev Console",
    "actions": [
        {
            "id": "aws-login",
            "label": "Sign in to AWS SSO",
            "script": "shared:aws-sso-login",
            "steps": [{ "type": "env-file" }]
        },
        {
            "id": "start",
            "label": "Start services",
            "script": "shared:start-services",
            "params": {
                "compose-file": "infrastructure/docker/docker-compose.yml",
                "profile": "main"
            },
            "steps": [
                { "type": "env-file" },
                {
                    "type": "choices",
                    "message": "Which services should run?",
                    "options": [
                        {
                            "name": "rebuild",
                            "label": "Containers",
                            "choices": [
                                { "value": "false", "label": "Use existing", "hint": "Builds only what is missing" },
                                { "value": "true", "label": "Rebuild", "hint": "Rebuilds the selected images without cache" }
                            ]
                        }
                    ],
                    "services": {
                        "composeFile": "infrastructure/docker/docker-compose.yml",
                        "baseProfile": "main",
                        "groups": [
                            { "label": "UI", "services": ["lixpi-web-ui", "lixpi-web-ui-user-portal"] },
                            { "label": "API", "services": ["lixpi-api"] },
                            {
                                "label": "Messaging and workers",
                                "groups": [
                                    { "label": "NATS cluster", "services": ["lixpi-nats-1", "lixpi-nats-2", "lixpi-nats-3", "lixpi-nats-cli"] },
                                    { "label": "NEX workers", "services": ["lixpi-nex-1"] }
                                ]
                            },
                            { "label": "Databases", "services": ["lixpi-dynamodb", "lixpi-dynamodb-admin"] },
                            { "label": "Infrastructure", "services": ["lixpi-pulumi-init"] },
                            { "label": "Auth", "services": ["lixpi-localauth0", "lixpi-caddy", "lixpi-local-https"] },
                            { "label": "Tools", "services": ["lixpi-ai-model-registry"] }
                        ]
                    }
                }
            ]
        },
        { "id": "configure", "label": "Create or edit a configuration", "script": "local:init-config", "returnToMenu": true },
        {
            "id": "infrastructure",
            "label": "Initialize infrastructure",
            "hint": "TLS certificates and DynamoDB tables",
            "script": "local:init-infrastructure",
            "steps": [{ "type": "env-file" }]
        },
        {
            "id": "pulumi",
            "label": "Deploy and manage infrastructure",
            "hint": "Everything the Pulumi service offers",
            "script": "local:pulumi",
            "steps": [{ "type": "env-file" }, { "type": "service-commands" }]
        },
        {
            "id": "prune",
            "label": "Prune Docker",
            "hint": "Reclaim disk space from containers, images, volumes and build cache",
            "script": "shared:prune-docker",
            "steps": [{ "type": "docker-prune" }]
        },
        { "id": "skills", "label": "Install agent skills", "script": "shared:setup-skills" }
    ]
}
