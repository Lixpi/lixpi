{
    "title": "Lixpi Dev Console",
    "actions": [
        {
            "id": "start",
            "label": "Start services",
            "script": "shared:start-services",
            "steps": [
                { "type": "env-file" },
                {
                    "type": "choices",
                    "message": "Which services should run?",
                    "options": [
                        {
                            "name": "rebuild",
                            "label": "Containers",
                            "choices": [
                                { "value": "false", "label": "Use existing", "hint": "Builds only what is missing" },
                                { "value": "true", "label": "Rebuild", "hint": "Rebuilds the selected images without cache" }
                            ]
                        },
                        {
                            "name": "detach",
                            "label": "Run",
                            "choices": [
                                { "value": "false", "label": "Foreground", "hint": "Keeps the console attached to the logs, Ctrl+C stops" },
                                { "value": "true", "label": "Detached", "hint": "Starts in the background and returns" }
                            ]
                        }
                    ],
                    "services": true
                }
            ]
        },
        {
            "id": "aws-login",
            "label": "Sign in to AWS SSO",
            "script": "shared:aws-sso-login",
            "steps": [{ "type": "env-file" }]
        },
        { "id": "configure", "label": "Create or edit a configuration", "script": "local:init-config", "returnToMenu": true },
        {
            "id": "infrastructure",
            "label": "Initialize infrastructure",
            "hint": "TLS certificates and DynamoDB tables",
            "script": "local:init-infrastructure",
            "steps": [{ "type": "env-file" }]
        },
        {
            "id": "pulumi",
            "label": "Deploy and manage infrastructure",
            "hint": "Everything the Pulumi service offers",
            "script": "local:pulumi",
            "steps": [{ "type": "env-file" }, { "type": "service-commands" }]
        },
        {
            "id": "prune",
            "label": "Prune Docker",
            "hint": "Reclaim disk space from containers, images, volumes and build cache",
            "script": "shared:prune-docker",
            "steps": [{ "type": "docker-prune" }]
        },
        { "id": "skills", "label": "Install agent skills", "script": "shared:setup-skills" }
    ]
}
